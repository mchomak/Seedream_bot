APP_NAME=mybot
APP_ENV=dev
DEBUG=true
# TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
# Set to DEBUG to see detailed user action logs with user IDs
LOG_LEVEL=INFO

TELEGRAM_BOT_TOKEN=123456789:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_ALERTS_CHAT_ID=123456789

# Telegram proxy settings
# Режим: none | media | full
#   none  — прокси только для AI API (Seedream), Telegram напрямую
#   media — прокси только для загрузки/отправки файлов (фото, документы)
#   full  — весь трафик Telegram через прокси
# Requires: pip install aiohttp-socks  (for socks5://)
#TELEGRAM_PROXY=socks5://user:pass@host:1080
#TELEGRAM_PROXY_MODE=none

# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
REDIS_URL=redis://redis:6379/0

# YooKassa Payment Configuration
# Get credentials from YooKassa merchant dashboard: https://yookassa.ru/my/shop/settings
# Documentation: https://yookassa.ru/developers/using-api/authentication
YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# Admin Panel Configuration
ADMIN_SECRET_KEY=your_random_secret_key_here_at_least_32_characters
ADMIN_PORT=8001